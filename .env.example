# LLM (Phase 1 — script agent)
OPENAI_API_KEY=

# Kling AI video gen — free tier (std mode, ~3-5 clips/day)
# สมัคร: https://app.klingai.com → API → Create API Key
# ใช้แค่ KLING_ACCESS_KEY พอ (key รูปแบบ api-key-kling-...)
KLING_ACCESS_KEY=
KLING_MODEL=kling-v1
KLING_MODE=std
KLING_DAILY_LIMIT=5

# Telegram reports (Phase 4-5)
# สร้าง bot กับ @BotFather → ได้ token; เอา chat id จาก @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# เปิดรับปุ่มกดอนุมัติจากมือถือ (ไม่ต้องเว็บโฮสต์)
TELEGRAM_POLL=true

# Publisher Agent — Risky Mode (Phase 6)
# ⚠️ ผิด ToS TikTok เสี่ยงแบน → ใช้ account รองเท่านั้น
# ติดตั้งก่อน: npm i playwright && npx playwright install chromium
# แล้วล็อกอิน TikTok ใน browser ครั้งแรกเพื่อเซฟ session ลงโฟลเดอร์นี้
PUBLISHER_MODE=false
PUBLISHER_SESSION_JSON=
PUBLISHER_MIN_DELAY=1500
PUBLISHER_MAX_DELAY=4000

# TikTok Shop Open API (Phase 4)
TIKTOK_SHOP_APP_KEY=
TIKTOK_SHOP_APP_SECRET=
TIKTOK_SHOP_SHOP_ID=

# วิธีที่แนะนำ (ร้านตัวเอง): เอา access_token จาก OAuth ใส่ตรงนี้
TIKTOK_SHOP_ACCESS_TOKEN=
# (อุปกรณ์เสริม) สำหรับรีเฟรช token อัตโนมัติ
TIKTOK_SHOP_REFRESH_TOKEN=

# ตัวเลือก
TIKTOK_SHOP_API_VERSION=202309
TIKTOK_SHOP_REGION=TH
TIKTOK_SHOP_API_BASE=https://open-api.tiktokglobalshop.com
